# The vendored upstream files must stay byte-identical (LF) on every platform;
# scripts/check-upstream.mjs compares hashes. Never let autocrlf rewrite them.
*.mjs text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
NOTICE text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
