{
  "name": "openviking-kiro",
  "version": "0.1.2",
  "description": "Long-term semantic memory for the Kiro IDE agent — powered by OpenViking. Auto-recall relevant memories and capture the conversation as it happens, as a thin host on OpenViking's agent-hook-plugin framework.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "openviking-kiro-install": "scripts/install.mjs",
    "openviking-kiro-uninstall": "scripts/uninstall.mjs"
  },
  "scripts": {
    "pretest": "node scripts/check-test-prereqs.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check-upstream": "node scripts/check-upstream.mjs",
    "sync-upstream": "node scripts/check-upstream.mjs --sync",
    "install:user": "node scripts/install.mjs",
    "uninstall:user": "node scripts/uninstall.mjs"
  },
  "author": {
    "name": "aerisnju",
    "url": "https://github.com/aerisnju"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aerisnju/openviking-kiro.git"
  },
  "homepage": "https://github.com/aerisnju/openviking-kiro#readme",
  "bugs": {
    "url": "https://github.com/aerisnju/openviking-kiro/issues"
  },
  "license": "AGPL-3.0",
  "keywords": [
    "memory",
    "openviking",
    "kiro",
    "semantic-search",
    "long-term-memory",
    "context-engine"
  ]
}
